<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Same bydauto permissions :app already holds for these devices. All of them are granted
         only to a platform-signed APK; a debug-signed build is refused at runtime and every
         signal reads UNAVAILABLE (no crash). -->
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_GET"/>
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_GET"/>
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_GET"/>
    <uses-permission android:name="android.permission.BYDAUTO_ENGINE_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_ENGINE_GET"/>
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_GET"/>

    <!-- UNVERIFIED NAMES. Nothing in this repo has used the statistic or charging devices yet, so
         these four follow the COMMON/GET pattern of the others but have not been seen on a car.
         Check them on the head unit before relying on SOC/range/charging widgets:
             adb shell pm list permissions | grep BYDAUTO
         A wrong name is silently ignored at install and its device reads UNAVAILABLE. -->
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_GET"/>
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_GET"/>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/GaugesTheme">

        <!-- Declared first and carrying CATEGORY_INFO: getLaunchIntentForPackage() resolves INFO
             before LAUNCHER, so Bydlak Dash always projects the dashboard, never the editor. -->
        <activity
            android:name=".runtime.DashboardActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:resizeableActivity="true"
            android:theme="@style/GaugesTheme.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.INFO"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".editor.EditorActivity"
            android:exported="true"
            android:label="@string/editor_name"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
